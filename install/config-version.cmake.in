# Fortran modules must match the compiler family and major version. Check this
# first because CMake's basic check may return early when pointer size is unset.
string(REGEX MATCH "^[0-9]+" _h5fw_compiler_major "${CMAKE_Fortran_COMPILER_VERSION}")
if (NOT CMAKE_Fortran_COMPILER_ID STREQUAL "@CMAKE_Fortran_COMPILER_ID@"
        OR NOT _h5fw_compiler_major STREQUAL "@Fortran_COMPILER_VERSION_MAJOR@")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif ()
unset(_h5fw_compiler_major)

@H5FW_BASIC_VERSION_CHECK@

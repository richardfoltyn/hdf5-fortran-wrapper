@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(HDF5 COMPONENTS Fortran)

set(@LIBRARY_NAME@_VERSION "@H5FW_VERSION@")
if (NOT TARGET @H5FW_INSTALL_NAMESPACE@::@LIBRARY_NAME@)
    include("${CMAKE_CURRENT_LIST_DIR}/@TARGETS_FILE@")
endif ()

# Retain the legacy variable without caching installation-specific paths.
# Linking @H5FW_INSTALL_NAMESPACE@::@LIBRARY_NAME@ supplies these automatically.
get_target_property(@LIBRARY_NAME@_INCLUDE_DIRS
    @H5FW_INSTALL_NAMESPACE@::@LIBRARY_NAME@ INTERFACE_INCLUDE_DIRECTORIES)

# Recheck module and link compatibility on each configure, including after
# the selected installation or toolchain has changed.
try_compile(_h5fw_compiler_compatible
    "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/h5fw-compiler-check"
    "${CMAKE_CURRENT_LIST_DIR}/compiler_test.f90"
    LINK_LIBRARIES @H5FW_INSTALL_NAMESPACE@::@LIBRARY_NAME@ hdf5::hdf5_fortran
    OUTPUT_VARIABLE _h5fw_compiler_output
)
set(@LIBRARY_NAME@_FOUND "${_h5fw_compiler_compatible}")
unset(_h5fw_compiler_compatible CACHE)
unset(@LIBRARY_NAME@_NOT_FOUND_MESSAGE)
if (NOT @LIBRARY_NAME@_FOUND)
    set(@LIBRARY_NAME@_NOT_FOUND_MESSAGE
        "The installed @LIBRARY_NAME@ library is incompatible with the current Fortran compiler or target architecture:\n${_h5fw_compiler_output}")
endif ()
unset(_h5fw_compiler_compatible)
unset(_h5fw_compiler_output)

check_required_components(@LIBRARY_NAME@)

if (@LIBRARY_NAME@_FOUND AND NOT @LIBRARY_NAME@_FIND_QUIETLY)
    message(STATUS "Found @LIBRARY_NAME@ ${@LIBRARY_NAME@_VERSION}: ${@LIBRARY_NAME@_INCLUDE_DIRS}")
endif ()

